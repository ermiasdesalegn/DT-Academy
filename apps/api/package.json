{
  "name": "@dt-academy/api",
  "version": "1.0.0",
  "private": true,
  "description": "Express.js API for DT Academy portal",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "seed:demo": "tsx src/seed/seedDemo.ts",
    "seed:demo:reset": "tsx src/seed/seedDemo.ts --reset"
  },
  "dependencies": {
    "@dt-academy/types": "*",
    "@prisma/client": "^6.13.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "prisma": "^6.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}

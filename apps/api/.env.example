PORT=5000

# Neon: Dashboard → Connect → Prisma
# DATABASE_URL = pooled connection (query)
# DIRECT_URL   = direct connection (migrations)
# Express is a long-running process: use the Neon DIRECT host (no -pooler).
# Pooler + Prisma's own pool often yields P1001 / P2024 on Windows.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=60"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
SEED_ADMIN_EMAIL=director@dt-academy.local
SEED_ADMIN_PASSWORD=ChangeMeNow!
SEED_ADMIN_NAME=Academy Director

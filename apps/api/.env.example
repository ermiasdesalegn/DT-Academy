PORT=5000

# Neon: Dashboard → Connect → Prisma
# DATABASE_URL = pooled connection (query)
# DIRECT_URL   = direct connection (migrations)
# Express is a long-running process: use the Neon DIRECT host (no -pooler).
# Pooler + Prisma's own pool often yields P1001 / P2024 on Windows.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=60"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
SEED_ADMIN_EMAIL=director@dt-academy.local
SEED_ADMIN_PASSWORD=ChangeMeNow!
SEED_ADMIN_NAME=Academy Director

# mock = local demo (no merchant keys). sandbox = Telebirr / M-Pesa test APIs.
PAYMENTS_MODE=mock
PUBLIC_WEB_URL=http://localhost:5173

# Contact form (Resend). In development, messages log to the API console if these are empty.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# Telebirr H5 C2B (sandbox). Notify URL must be public HTTPS (ngrok) in sandbox mode.
TELEBIRR_BASE_URL=https://developerportal.ethiotelebirr.et:38443/apiaccess/payment/gateway
TELEBIRR_WEB_PAY=https://developerportal.ethiotelebirr.et:38443/payment/web/paygate?
FABRIC_APP_ID=
FABRIC_APP_SECRET=
MERCHANT_APP_ID=
MERCHANT_CODE=
TELEBIRR_PRIVATE_KEY=
TELEBIRR_NOTIFY_URL=
TELEBIRR_REDIRECT_URL=http://localhost:5173/portal/pay/return

# Safaricom Ethiopia M-Pesa sandbox
MPESA_BASE_URL=https://apisandbox.safaricom.et
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
